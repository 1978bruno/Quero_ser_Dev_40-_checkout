<h1 class="ls-title-intro ls-md-margin-bottom">Lista de Usuários</h1>
<%= link_to 'Criar Usuário', new_users_admin_path, class: 'ls-btn-primary ls-md-margin-bottom' %>
<% if @users.any? %>
  <table class="ls-table ls-table-striped">
    <thead>
      <tr>
        <th><%= User.human_attribute_name(:name)%></th>
        <th><%= User.human_attribute_name(:email)%></th>
        <th><%= User.human_attribute_name(:admin)%></th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr id="<%= dom_id(user) %>">
          <td><%= user.name %></td>
          <td><%= user.email %></td>
          <td id="user_admin">
            <% if user.try(:admin?) %>
              <span class="ls-ico-checkmark"></span>
            <% end %>
          </td>
          <td>
            <div class="ls-display-inline-block ls-md-margin-right">
              <%= link_to 'Editar', edit_users_admin_path(user), class: 'ls-btn-primary-sm' %>
            </div>
            <div class="ls-display-inline-block">
              <% unless user.try(:admin?) %>
                <%= button_to (user.active)?'Bloquear':'Desbloquear', lock_unlock_users_admin_path(user), method: :patch, class: 'ls-btn-primary-sm' %>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>Não existem usuários cadastrados.</p>
<% end %>
