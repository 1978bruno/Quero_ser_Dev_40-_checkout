<h1>Lista de Vendedores</h1>

<%= link_to 'Criar Usuário', new_users_admin_path, class: 'ls-btn-primary ls-md-margin-bottom' %>

<% if current_user.admin %>
  <div class="ls-box-filter">
    <%= form_with url: users_path, method: :get, :class => 'ls-form ls-form-inline ls-float-right'  do %>
      <%= label_tag :query, 'Busca', {for: 'name', class: 'ls-label-text ls-hidden-accessible'} %>
        <%= text_field_tag :query %>
      <%= submit_tag 'Buscar', {class: "ls-btn"} %>
    <% end %>
  </div>
<% end %>
<div>
  <% @users.each do |user|%>
    <div class= "ls-md-margin-bottom" id="<%= dom_id(user) %>">
      <%= User.human_attribute_name(:name)%>: <%= user.name%><br>
      <%= User.human_attribute_name(:email)%>: <%= user.email%><br>
      <%= link_to 'Editar usuário', edit_users_admin_path(user), class: 'ls-btn-primary-sm' %>
    </div>
  <% end %>
</div>
