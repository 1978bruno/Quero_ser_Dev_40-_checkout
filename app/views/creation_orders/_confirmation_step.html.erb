<%= render "stepper" %>

<div class="ls-box">
  <h3 class="ls-md-margin-bottom">Confirmação</h3>

  <%= form_for @creation_order, class: "ls-form ls-form-horizontal row" do | f | %>
    <table class="ls-table ls-table-striped">
      <thead>
        <tr>
          <th>Produto</th>
          <th>Plano</th>
          <th>Periodicidade</th>
          <th>Preço</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><%= @creation_order.product_group_name %></td>
          <td><%= @creation_order.product_plan_name %></td>
          <td><%= @creation_order.product_periodicity %></td>
          <td><%= number_to_currency(@creation_order.product_price) %></td>
        </tr>
      </tbody>
    </table>

    <div class="ls-actions-btn">
      <%= f.submit 'Confirmar', class: "ls-btn-primary" %>
      <%= f.submit "Voltar", name: "back_button", class: "ls-btn-primary" unless @creation_order.first_step? %>
    </div>
  <% end %>
</div>
