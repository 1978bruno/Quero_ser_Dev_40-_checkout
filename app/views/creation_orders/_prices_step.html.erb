<%= render "stepper" %>

<div class="ls-box">
  <h3 class="ls-md-margin-bottom"><%= @creation_order.product_group %> / <%= @creation_order.product_plan %></h3>

  <% if @creation_order.errors.any? %>
    <div class="ls-alert-danger ls-dismissable">
      <span data-ls-module="dismiss" class="ls-dismiss">&times;</span>
      <p><%= @creation_order.errors.where(:product_price_component).first.full_message %></p>
    </div>
  <% end %>

  <%= form_for @creation_order, class: "ls-form ls-form-horizontal row" do | f | %>
    <fieldset>
      <% @product_plan_prices.each do |price| %>
        <div class="col-md-3 col-lg-3 col-sm-3">
          <label>
            <%= f.radio_button :product_price_component, "#{price[:periodicity]} #{price[:price]}", class: "card-input-element" %>
              <div class="card-input">
                <h3 class="ls-txt-center"><%= price[:periodicity] %></h3>
                <div class="ls-md-margin-top ls-txt-center"><%= number_to_currency(price[:price]) %></div>
              </div>
          </label>
        </div>
      <% end %>
    </fieldset>

    <div class="ls-actions-btn">
      <%= f.submit 'Continuar', class: "ls-btn-primary" %>
      <%= f.submit "Voltar", name: "back_button", class: "ls-btn-primary" unless @creation_order.first_step? %>
    </div>
  <% end %>
</div>
