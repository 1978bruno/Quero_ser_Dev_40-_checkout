<%= render "stepper" %>

<h1>Plans Step</h1>

<div class="ls-box">
  <%= form_for @creation_order, class: "ls-form ls-form-horizontal row" do | f | %>
    <% if @product_plans.any? %>
      <table class="ls-table ls-table-striped">
        <thead>
          <tr>
            <th>Nome</th>
            <th>Descrição</th>
            <th>Detalhes</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody>
          <% @product_plans.each do |plan| %>
            <tr>
              <td><%= plan[:name] %></td>
              <td><%= plan[:description] %></td>
              <td><%= plan[:details] %></td>
              <td><%= f.radio_button :product_plan, plan[:name], class: "ls-label-text" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p>Não existem planos disponíveis para o produto</p>
    <% end %>

    <div class="ls-actions-btn">
      <%= f.submit 'Continuar', class: "ls-btn-primary" %>
      <%= f.submit "Voltar", name: "back_button", class: "ls-btn-primary" unless @creation_order.first_step? %>
    </div>
  <% end %>
</div>
