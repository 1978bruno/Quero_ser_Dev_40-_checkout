<%= render "stepper" %>

<div class="ls-box">
  <h3 class="ls-md-margin-bottom">Grupo de produtos</h3>

  <% if @creation_order.errors.any? %>
    <div class="ls-alert-danger ls-dismissable">
      <span data-ls-module="dismiss" class="ls-dismiss">&times;</span>
      <p><%= @creation_order.errors.where(:product_group).first.full_message %></p>
    </div>
  <% end %>

  <%= form_for @creation_order, class: "ls-form ls-form-horizontal row" do | f | %>
    <fieldset>
      <% @products.each do |product| %>
        <div class="col-md-3 col-lg-3 col-sm-3">
          <label>
            <%= f.radio_button :product_group, product[:name], class: "card-input-element" %>
              <div class="card-input">
                <div class="ls-txt-center"><%= product[:name] %></div>
              </div>
          </label>
        </div>
      <% end %>
    </fieldset>

    <div class="ls-actions-btn">
      <%= f.submit 'Continuar', class: "ls-btn-primary" %>
      <%= f.submit "Voltar", name: "back_button", class: "ls-btn-primary" unless @creation_order.first_step? %>
    </div>
  <% end %>
</div>
