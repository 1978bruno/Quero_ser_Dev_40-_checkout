<h1 class="ls-title-intro ls-md-margin-bottom">Lista de Clientes Bloqueados</h1>
<div class="ls-box-filter">
    <div class="ls-display-block ls-sm-margin-bottom">
      <h4>Pesquisar cliente para bloqueio/desbloqueio</h4>
    </div>
    <%= form_with url: blacklisted_customers_path, method: :get, :class => 'ls-form ls-form-inline ls-float-left'  do %>
      <%= label_tag :customer_doc_ident, 'Busca', {for: 'name', class: 'ls-label-text ls-hidden-accessible'} %>
        <%= text_field_tag :customer_doc_ident, params[:customer_doc_ident] || '' %>
      <%= submit_tag 'Buscar', {class: "ls-btn"} %>
      <%= link_to 'Limpar pesquisa', blacklisted_customers_path,  class: "ls-btn" %>
    <% end %>
</div>

<% if @customer.present? %>
  <div class="ls-box-filter">
      <div class="ls-display-block ls-sm-margin-bottom">
        <h3>Detalhes do cliente</h3>
         <%= form_with url: save_blacklisted_customer_path(@customer[:doc_ident]), method: :post, class: 'ls-form'  do %>
          <fieldset>
            <%= label_tag :customer_doc_ident,'Número do documento:' , {class: 'ls-label ls-text-sm ls-md-margin-top ls-sm-margin-bottom'} %>
            <%= text_field_tag :customer_doc_ident, @customer[:doc_ident], disabled:true %>

            <%= label_tag :customer_name,'Nome:' , {class: 'ls-label ls-text-sm ls-md-margin-top ls-sm-margin-bottom'} %>
            <%= text_field_tag :customer_name, @customer[:name], disabled:true %>
                      
          <% unless @is_blacklisted %>  
            <%= label_tag :blacklisted_reason, 'Razão para bloqueio:', {class: 'ls-label ls-text-sm ls-md-margin-top ls-sm-margin-bottom'} %>
            <%= text_area_tag :blacklisted_reason, '', required: true %>          
            <%= submit_tag('Bloquear cliente', {class: "ls-btn"}) %>
          <% end %>
          </fieldset>
        <% end %>
      </div>
  </div>
<% end %>

<% if @blacklisted_customers.any? %>
  <table class="ls-table ls-table-striped">
    <thead>
      <tr>
        <th><%= User.human_attribute_name(:doc_ident)%></th>
        <th><%= User.human_attribute_name(:blacklisted_reason)%></th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      <% @blacklisted_customers.each do |customer| %>
        <tr id="<%= dom_id(customer) %>">
          <td><%= customer.doc_ident %><%= link_to " (ver detalhes)","#{blacklisted_customers_path}/?customer_doc_ident=#{customer.doc_ident}" %></td>
          <td><%= customer.blacklisted_reason %></td>
          <td>
            <div class="ls-display-inline-block">
                <%= button_to 'Desbloquear', blacklisted_customer_path(customer), method: :delete, class: 'ls-btn-primary-sm' %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>Não existem clientes bloqueados.</p>
<% end %>