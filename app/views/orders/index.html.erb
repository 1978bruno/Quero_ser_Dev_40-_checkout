<h2>Pedidos</h2>

<% if @orders.any? %>
  <table class="ls-table ls-table-striped">
    <thead>
      <tr>
        <th><%= I18n.t(@orders[0].salesman)%></th>
        <th class="hidden-xs"><%= I18n.t(@orders[0].customer)%></th>
        <th><%= I18n.t(@orders[0].product_plan_name)%></th>
        <th class="hidden-xs"><%= I18n.t(@orders[0].product_plan_periodicity)%></th>
        <th><%= I18n.t(@orders[0].price)%></th>
        <th class="hidden-xs"><%= I18n.t(@orders[0].discount)%></th>
        <th><%= I18n.t(@orders[0].payment_mode)%></th>
        <th class="hidden-xs"><%= I18n.t(@orders[0].status)%></th>
      </tr>
    </thead>
    <tbody>
      <% @orders.each do |order| %>
        <tr class='order_info' id='order_id_<%=order.id%>'>
          <td><%= link_to order_path(order.id) %></td>
          <td><%= order.salesman.email %></td>
          <td class="hidden-xs"><%= order.customer.doc_ident %></td>
          <td><%= order.product_plan_name %></td>
          <td class="hidden-xs"><%= order.product_plan_periodicity %></td>
          <td><%= number_to_currency(order.price) %></td>
          <td class="hidden-xs"><%= order.discount %></td>
          <td><%= order.payment_mode %></td>
          <td class="hidden-xs"><%= I18n.t(order.status) %></td>
          <% if @order.pending? %>
            <td>
              <%= button_to 'Cancelar', order_cancel_reason(order.id), method: :get %>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>Não existem pedidos cadastrados.</p>
<% end %>

<p><%= link_to 'Voltar', root_path %></p>